# Production public web assets are tracked directly as binary files (bypassing LFS pointer conversion)
# so automated build environments (Vercel, Netlify, Cloudflare Pages, GitHub Pages) always deploy real image binaries.
public/** -filter -diff -merge

# Git LFS tracking for raw repository archives outside public/
"Engagemnt/**" filter=lfs diff=lfs merge=lfs -text
"Events/**" filter=lfs diff=lfs merge=lfs -text
"Pre Wedding/**" filter=lfs diff=lfs merge=lfs -text
"Wedding/**" filter=lfs diff=lfs merge=lfs -text
"other celeb/**" filter=lfs diff=lfs merge=lfs -text
